{
  "name": "liuhen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "node scripts/prepare-tests.mjs && vue-tsc --noEmit",
    "build": "node scripts/prepare-tests.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/prepare-tests.mjs && vitest run",
    "test:coverage": "node scripts/prepare-tests.mjs && vitest run --coverage"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "element-plus": "2.14.7",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
