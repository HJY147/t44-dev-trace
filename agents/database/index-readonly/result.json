    {
      "label": "create:tasks",
      "sql": "SHOW CREATE TABLE `tasks`",
      "bound_integers": [],
      "rows": [
        {
          "Table": "tasks",
          "Create Table": "CREATE TABLE `tasks` (\n  `id` int unsigned NOT NULL AUTO_INCREMENT,\n  `project_id` int unsigned NOT NULL,\n  `iteration_id` int unsigned NOT NULL,\n  `title` varchar(200) NOT NULL,\n  `description` varchar(4000) NOT NULL,\n  `owner_id` int unsigned NOT NULL,\n  `state` tinyint unsigned NOT NULL DEFAULT '1',\n  `version` int unsigned NOT NULL DEFAULT '1',\n  `schedule_version` int unsigned NOT NULL DEFAULT '1',\n  `delivery_cycle` int unsigned NOT NULL DEFAULT '1',\n  `review_cycle` int unsigned NOT NULL DEFAULT '1',\n  `planned_start` datetime(6) NOT NULL,\n  `planned_end` datetime(6) NOT NULL,\n  `estimated_quarters` mediumint unsigned NOT NULL,\n  `buffer_quarters` smallint unsigned NOT NULL,\n  `delay_contingency` varchar(2000) NOT NULL,\n  `blocked_from_state` tinyint unsigned DEFAULT NULL,\n  `block_reason` varchar(2000) DEFAULT NULL,\n  `responsibility_stage` tinyint unsigned DEFAULT NULL,\n  `artifact_revision` char(40) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `latest_review_id` int unsigned DEFAULT NULL,\n  `approved_review_id` int unsigned DEFAULT NULL,\n  `approved_assessment_id` int unsigned DEFAULT NULL,\n  `approved_assessment_version` int unsigned DEFAULT NULL,\n  `escalation_count` int unsigned NOT NULL DEFAULT '0',\n  `created_at` datetime(6) NOT NULL,\n  `updated_at` datetime(6) NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_tasks_project_id` (`project_id`,`id`),\n  KEY `ix_tasks_project_state` (`project_id`,`state`,`id`),\n  KEY `ix_tasks_owner_state` (`project_id`,`owner_id`,`state`,`id`),\n  KEY `ix_tasks_iteration` (`project_id`,`iteration_id`,`id`),\n  KEY `ix_tasks_scan` (`state`,`planned_end`,`id`),\n  KEY `fk_tasks_latest_review` (`id`,`latest_review_id`),\n  KEY `fk_tasks_approved_review` (`id`,`approved_review_id`),\n  KEY `fk_tasks_approved_assessment` (`id`,`approved_assessment_id`),\n  CONSTRAINT `fk_tasks_approved_assessment` FOREIGN KEY (`id`, `approved_assessment_id`) REFERENCES `release_assessments` (`task_id`, `id`),\n  CONSTRAINT `fk_tasks_approved_review` FOREIGN KEY (`id`, `approved_review_id`) REFERENCES `reviews` (`task_id`, `id`),\n  CONSTRAINT `fk_tasks_iteration` FOREIGN KEY (`project_id`, `iteration_id`) REFERENCES `iterations` (`project_id`, `id`),\n  CONSTRAINT `fk_tasks_latest_review` FOREIGN KEY (`id`, `latest_review_id`) REFERENCES `reviews` (`task_id`, `id`),\n  CONSTRAINT `fk_tasks_owner` FOREIGN KEY (`project_id`, `owner_id`) REFERENCES `project_members` (`project_id`, `user_id`),\n  CONSTRAINT `fk_tasks_project` FOREIGN KEY (`project_id`) REFERENCES `projects` (`id`),\n  CONSTRAINT `ck_tasks_assessment_pair` CHECK ((((`approved_assessment_id` is null) and (`approved_assessment_version` is null)) or ((`approved_assessment_id` is not null) and (`approved_assessment_version` is not null) and (`approved_assessment_version` between 1 and 2147483647)))),\n  CONSTRAINT `ck_tasks_block` CHECK ((((`state` = 3) and (`blocked_from_state` is not null) and (`blocked_from_state` in (1,2,4,5)) and (`block_reason` is not null) and (char_length(trim(`block_reason`)) > 0) and (`responsibility_stage` is not null) and (`responsibility_stage` between 1 and 5)) or ((`state` <> 3) and (`blocked_from_state` is null) and (`block_reason` is null) and (`responsibility_stage` is null)))),\n  CONSTRAINT `ck_tasks_escalations` CHECK ((`escalation_count` <= 2147483647)),\n  CONSTRAINT `ck_tasks_hours` CHECK (((`estimated_quarters` between 1 and 400000) and (`buffer_quarters` <= 40000))),\n  CONSTRAINT `ck_tasks_state` CHECK ((`state` between 1 and 7)),\n  CONSTRAINT `ck_tasks_time` CHECK ((`planned_end` > `planned_start`)),\n  CONSTRAINT `ck_tasks_versions` CHECK (((`version` between 1 and 2147483647) and (`schedule_version` between 1 and 2147483647) and (`delivery_cycle` between 1 and 2147483647) and (`review_cycle` between 1 and 2147483647)))\n) ENGINE=InnoDB AUTO_INCREMENT=6005 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"
        }
      ]
    },
