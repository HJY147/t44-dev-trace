+def start_run(
+    g, run_id, rule_version, rule_snapshot, rule_hash, now, *,
+    existing=None, duplicate_lock="update", conflict_error=StatementRejected,
+):
+    """Return (identifier, reused row or None), without owning the transaction."""
+    key = uuid_to_bytes(run_id)
+    if existing is None:
+        try:
+            with g.savepoint():
+                identifier = g.insert(
+                    "scan_runs",
+                    dict(
+                        run_key=key,
+                        rule_version=rule_version,
+                        rule_snapshot=rule_snapshot,
+                        rule_hash=rule_hash,
+                        cutoff_at=now,
+                        status=1,
+                        last_task_id=0,
+                        scanned_count=0,
+                        created_count=0,
+                        duplicate_count=0,
+                        started_at=now,
+                        heartbeat_at=now,
+                        finished_at=None,
+                        error_code=None,
+                    ),
+                )
+            return identifier, None
+        except PersistenceIntegrityError as error:
+            if error.kind != "duplicate":
+                raise
+        rows = g.rows("scan_runs", {"run_key": key}, limit=1, lock=duplicate_lock)
+        if not rows:
+            raise StatementRejected("Unknown scan run")
+        existing = rows[0]
+    if existing["rule_hash"] != rule_hash or existing["rule_version"] != rule_version:
+        raise conflict_error("Run UUID cannot change rule snapshot")
+    return existing["id"], existing
 
 
